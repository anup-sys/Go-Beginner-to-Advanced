# 🛠 Step 3: Create MySQL Database

```sql
CREATE DATABASE studentdb;

USE studentdb;

CREATE TABLE students(
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100),
    age INT,
    course VARCHAR(100)
);
```

---

# 🛠 Step 4: Database Connection

## database/db.go

```go
package database

import (
    "database/sql"
    _ "github.com/go-sql-driver/mysql"
)

var DB *sql.DB

func ConnectDB() {

    db, err := sql.Open(
        "mysql",
        "root:password@tcp(localhost:3306)/studentdb",
    )

    if err != nil {
        panic(err)
    }

    DB = db
}
```

---

# 🛠 Step 5: Student Model

## models/student.go

```go
package models

type Student struct {
    ID     int    `json:"id"`
    Name   string `json:"name"`
    Age    int    `json:"age"`
    Course string `json:"course"`
}
```

---

# 🛠 Step 6: Create Student API (POST)

```go
func CreateStudent(w http.ResponseWriter, r *http.Request) {

    var student models.Student

    json.NewDecoder(r.Body).Decode(&student)

    query := "INSERT INTO students(name,age,course) VALUES(?,?,?)"

    database.DB.Exec(
        query,
        student.Name,
        student.Age,
        student.Course,
    )

    fmt.Fprintf(w, "Student Added Successfully")
}
```

---

# 🛠 Step 7: Get All Students (GET)

```go
func GetStudents(w http.ResponseWriter, r *http.Request) {

    rows, _ := database.DB.Query(
        "SELECT * FROM students",
    )

    var students []models.Student

    for rows.Next() {

        var s models.Student

        rows.Scan(
            &s.ID,
            &s.Name,
            &s.Age,
            &s.Course,
        )

        students = append(students, s)
    }

    json.NewEncoder(w).Encode(students)
}
```

---

# 🛠 Step 8: Update Student (PUT)

```go
func UpdateStudent(w http.ResponseWriter, r *http.Request) {

    var student models.Student

    json.NewDecoder(r.Body).Decode(&student)

    database.DB.Exec(
        "UPDATE students SET name=?,age=?,course=? WHERE id=?",
        student.Name,
        student.Age,
        student.Course,
        student.ID,
    )

    fmt.Fprintf(w, "Student Updated")
}
```

---

# 🛠 Step 9: Delete Student (DELETE)

```go
func DeleteStudent(w http.ResponseWriter, r *http.Request) {

    id := r.URL.Query().Get("id")

    database.DB.Exec(
        "DELETE FROM students WHERE id=?",
        id,
    )

    fmt.Fprintf(w, "Student Deleted")
}
```

---

# 🛠 Step 10: Main Function

## main.go

```go
package main

import (
    "fmt"
    "net/http"

    "crudapi/database"
)

func main() {

    database.ConnectDB()

    http.HandleFunc("/students", GetStudents)
    http.HandleFunc("/student/add", CreateStudent)
    http.HandleFunc("/student/update", UpdateStudent)
    http.HandleFunc("/student/delete", DeleteStudent)

    fmt.Println("Server Running at Port 8080")

    http.ListenAndServe(":8080", nil)
}
```

