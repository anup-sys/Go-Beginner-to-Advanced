# 🛠 Step 8: Configure Routes

```go
package main

import (
    "github.com/gin-gonic/gin"
)

func main() {

    router := gin.Default()

    router.POST(
        "/login",
        Login,
    )

    admin := router.Group("/admin")
    admin.Use(
        AuthMiddleware,
        RoleMiddleware("admin"),
    )

    admin.GET(
        "/dashboard",
        AdminDashboard,
    )

    student := router.Group("/student")
    student.Use(
        AuthMiddleware,
        RoleMiddleware("student"),
    )

    student.GET(
        "/dashboard",
        StudentDashboard,
    )

    router.Run(":8080")
}
```

