# 📝 Real-Life Problems

## Problem 1: Print Table of 5

```go
package main

import "fmt"

func main() {
    for i := 1; i <= 10; i++ {
        fmt.Println("5 x", i, "=", 5*i)
    }
}
```

---

## Problem 2: Calculate Sum of First 10 Numbers

```go
package main

import "fmt"

func main() {
    sum := 0

    for i := 1; i <= 10; i++ {
        sum += i
    }

    fmt.Println("Sum =", sum)
}
```

### Output

```text
Sum = 55
```

---

## Problem 3: Count Even Numbers

```go
package main

import "fmt"

func main() {
    for i := 1; i <= 10; i++ {
        if i%2 == 0 {
            fmt.Println(i)
        }
    }
}
```

---

## Problem 4: Factorial of a Number

```go
package main

import "fmt"

func main() {
    number := 5
    factorial := 1

    for i := 1; i <= number; i++ {
        factorial *= i
    }

    fmt.Println("Factorial =", factorial)
}
```

### Output

```text
Factorial = 120
```

---

## Problem 5: Reverse Counting

```go
package main

import "fmt"

func main() {
    for i := 10; i >= 1; i-- {
        fmt.Println(i)
    }
}
```

