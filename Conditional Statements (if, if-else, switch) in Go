## Problem 3: Positive or Negative Number

```go
package main

import "fmt"

func main() {
    num := -5

    if num >= 0 {
        fmt.Println("Positive Number")
    } else {
        fmt.Println("Negative Number")
    }
}
```

---

## Problem 4: Traffic Signal

```go
package main

import "fmt"

func main() {
    signal := "Red"

    switch signal {
    case "Red":
        fmt.Println("Stop")
    case "Yellow":
        fmt.Println("Ready")
    case "Green":
        fmt.Println("Go")
    }
}
```

