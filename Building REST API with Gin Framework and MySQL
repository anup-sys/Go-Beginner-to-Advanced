# 🛠 Step 3: Create MySQL Database

```sql
CREATE DATABASE studentdb;

USE studentdb;

CREATE TABLE students(
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100),
    age INT,
    course VARCHAR(100)
);
```

---

# 🛠 Step 4: Database Connection

## database/db.go

```go
package database

import (
    "database/sql"

    _ "github.com/go-sql-driver/mysql"
)

var DB *sql.DB

func ConnectDB() {

    db, err := sql.Open(
        "mysql",
        "root:password@tcp(localhost:3306)/studentdb",
    )

    if err != nil {
        panic(err)
    }

    DB = db
}
```

---

# 🛠 Step 5: Create Model

## models/student.go

```go
package models

type Student struct {
    ID     int    `json:"id"`
    Name   string `json:"name"`
    Age    int    `json:"age"`
    Course string `json:"course"`
}
```

---

# 🛠 Step 6: Create Student API

## POST API

```go
func CreateStudent(c *gin.Context) {

    var student models.Student

    c.BindJSON(&student)

    query := "INSERT INTO students(name,age,course) VALUES(?,?,?)"

    database.DB.Exec(
        query,
        student.Name,
        student.Age,
        student.Course,
    )

    c.JSON(200, gin.H{
        "message": "Student Added",
    })
}
```

---

# 🛠 Step 7: Get All Students

```go
func GetStudents(c *gin.Context) {

    rows, _ := database.DB.Query(
        "SELECT * FROM students",
    )

    var students []models.Student

    for rows.Next() {

        var s models.Student

        rows.Scan(
            &s.ID,
            &s.Name,
            &s.Age,
            &s.Course,
        )

        students = append(students, s)
    }

    c.JSON(200, students)
}
```

---

# 🛠 Step 8: Get Student By ID

```go
func GetStudent(c *gin.Context) {

    id := c.Param("id")

    var student models.Student

    database.DB.QueryRow(
        "SELECT * FROM students WHERE id=?",
        id,
    ).Scan(
        &student.ID,
        &student.Name,
        &student.Age,
        &student.Course,
    )

    c.JSON(200, student)
}
```

---

# 🛠 Step 9: Update Student

```go
func UpdateStudent(c *gin.Context) {

    id := c.Param("id")

    var student models.Student

    c.BindJSON(&student)

    database.DB.Exec(
        "UPDATE students SET name=?,age=?,course=? WHERE id=?",
        student.Name,
        student.Age,
        student.Course,
        id,
    )

    c.JSON(200, gin.H{
        "message": "Student Updated",
    })
}
```

---

# 🛠 Step 10: Delete Student

```go
func DeleteStudent(c *gin.Context) {

    id := c.Param("id")

    database.DB.Exec(
        "DELETE FROM students WHERE id=?",
        id,
    )

    c.JSON(200, gin.H{
        "message": "Student Deleted",
    })
}
```

---

# 🛠 Step 11: Configure Routes

## main.go

```go
package main

import (
    "github.com/gin-gonic/gin"

    "gincrudapi/database"
)

func main() {

    database.ConnectDB()

    router := gin.Default()

    router.POST("/students", CreateStudent)
    router.GET("/students", GetStudents)
    router.GET("/students/:id", GetStudent)
    router.PUT("/students/:id", UpdateStudent)
    router.DELETE("/students/:id", DeleteStudent)

    router.Run(":8080")
}
```

